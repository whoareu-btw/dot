#!/usr/bin/env python3

import subprocess
import sys

ROFI_STYLING = """
* {
  font: "JetBrainsMono Nerd Font Propo 16";
}
window {
  width: 13em;
  padding: 20px;
}
mainbox {
  spacing: 15px;
}
listview {
  lines: 3;
  spacing: 10px;
}
element {
  padding: 10px 15px;
}
"""

def run_rofi(options: list, prompt: str) -> str:
    """Menjalankan Rofi dengan daftar opsi dan mengembalikan pilihan user."""
    options_str = "\n".join(options)
    cmd = [
        "rofi", "-dmenu", "-i", "-p", prompt,
        "-theme-str", ROFI_STYLING
    ]
    try:
        result = subprocess.run(
            cmd, input=options_str, text=True, capture_output=True, check=True
        )
        return result.stdout.strip()
    except subprocess.CalledProcessError:
        return ""

def get_distrobox_containers() -> list:
    """Mengambil daftar container Distrobox dengan membersihkan format tabel."""
    try:
        result = subprocess.run(
            ["distrobox", "list", "--no-color"], 
            capture_output=True, text=True, check=True
        )
        lines = result.stdout.strip().split('\n')[1:]
        containers = [line.split('|')[1].strip() for line in lines if '|' in line]
        return containers
    except Exception:
        return []

def main():
    main_options = [" Neovim", "󰆧 Distrobox (Podman)"]
    chosen_main = run_rofi(main_options, "")

    if not chosen_main:
        sys.exit(0)

    if chosen_main == " Neovim":
        foot_cmd = [
            "foot", 
            "-e", 
            "env", 
            "SHELL=/bin/bash", 
            "nvim"
        ]
        subprocess.Popen(foot_cmd, start_new_session=True)
        
    elif chosen_main == "󰆧 Distrobox (Podman)":
        containers = get_distrobox_containers()
        
        if not containers:
            subprocess.Popen(["rofi", "-e", "Tidak ada container Distrobox ditemukan."])
            sys.exit(1)
            
        chosen_container = run_rofi(containers, "")
        
        if not chosen_container:
            sys.exit(0)
            
        foot_cmd = [
            "foot",
            f"--app-id=distrobox-{chosen_container}",
            f"--title=Distrobox: {chosen_container}",
            "-e",
            "distrobox",
            "enter",
            chosen_container,
            "--",
            "bash" 
        ]
        
        subprocess.Popen(foot_cmd, start_new_session=True)

if __name__ == "__main__":
    main()
