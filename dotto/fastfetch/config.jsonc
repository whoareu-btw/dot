{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "padding": {
      "top": 0,
      "right": 6
    }
  },

  "display": {
    "separator": " ›  "
  },
  "modules": [
    "break",
      {
        "type": "os",
        "key": " ",
        "keyColor": "34"  // = color1
      },
      {
        "type": "host",
        "key": "󰌢 ",
        "keyColor": "34"
      },
      {
        "type": "cpu",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "gpu",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "kernel",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "packages",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "shell",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "terminal",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "wm",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "memory",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "swap",
        "key": " ",
        "keyColor": "34"
      },
      {
        "type": "battery",
        "key": " ",
        "keyColor": "34"
      },
    "break"
  ]
}
